{
  "expo": {
    "name": "Tapi Super-Search",
    "slug": "tapi-super-search",
    "version": "1.6.21",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "tapi",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
